# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Backend Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Metrics collector (writes compact count snapshots to the graphile_worker_ui
# schema so throughput/backlog charts survive restarts). All optional.
GW_UI_SNAPSHOT_INTERVAL_MS=5000
GW_UI_SNAPSHOT_RETENTION_DAYS=7
# GW_UI_POOL_MAX=8

# Frontend Configuration
VITE_GRAPHQL_URL=http://localhost:5001/graphql
VITE_GRAPHQL_WS_URL=ws://localhost:5001/graphql
# Optional: defaults to VITE_GRAPHQL_URL with /graphql swapped for /api
# VITE_API_URL=http://localhost:5001/api
VITE_NODE_ENV=development

# Docker Compose Environment
COMPOSE_PROJECT_NAME=graphile-worker-ui
